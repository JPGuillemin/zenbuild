. /etc/shell-colors
shopt -s nullglob

export CWD="$(pwd)"
export ME="$(readlink -f "${BASH_SOURCE[0]}")"
export JOBS="${JOBS:-$(nproc 2>/dev/null || echo 1)}"

# Slackware pkgtools (makepkg) commonly live in /sbin or /usr/sbin.
for dir in /sbin /usr/sbin /usr/local/sbin; do
  case ":${PATH}:" in
    *":${dir}:"*) ;;
    *) PATH="${PATH:+${PATH}:}${dir}" ;;
  esac
done
export PATH

die() {
  echo -e "${BOLDRED}Error:${COLOR_RESET} $*" >&2
  exit 1
}

usage() {
  echo -e "${BOLDCYAN}Usage: $0 [OPTIONS] SOURCE [VERSION] [NAME]${COLOR_RESET}"
  echo -e "${BOLDCYAN}  SOURCE can be a source archive, a .deb/.rpm/.txz/.AppImage,${COLOR_RESET}"
  echo -e "${BOLDCYAN}  or a .git/.url/.pip/.pkg/.skel recipe.${COLOR_RESET}"
  echo
  echo -e "${BOLDCYAN}Options:${COLOR_RESET}"
  echo "  -o, --output DIR       output directory (default: /tmp)"
  echo "  -b, --build NUMBER     build number (default: today's YYMMDD)"
  echo "  -s, --build-system SYS force auto, cmake, meson, autotools, make, perl, python, pip"
  echo "  -c, --extra-config OPT extra configure/cmake/meson options"
  echo "  -h, --help             show this help"
  echo
  echo -e "${BOLDCYAN}Environment: OUTPUT VERSION NAME BUILD EXTRACONFIG${COLOR_RESET}"
  echo "  NO_FAKEROOT=1 disables automatic fakeroot"
}

buildSystem="auto"
positional=()
ORIG_ARGS=("$@")

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -o|--output)
      [[ $# -ge 2 ]] || die "Option $1 requires an argument"
      OUTPUT="$2"
      shift 2
      ;;
    -b|--build)
      [[ $# -ge 2 ]] || die "Option $1 requires an argument"
      BUILD="$2"
      shift 2
      ;;
    -s|--build-system)
      [[ $# -ge 2 ]] || die "Option $1 requires an argument"
      buildSystem="${2,,}"
      shift 2
      ;;
    -c|--extra-config)
      [[ $# -ge 2 ]] || die "Option $1 requires an argument"
      EXTRACONFIG="$2"
      shift 2
      ;;
    --)
      shift
      positional+=("$@")
      break
      ;;
    -*)
      die "Unknown option: $1 (try --help)"
      ;;
    *)
      positional+=("$1")
      shift
      ;;
  esac
done

case "${buildSystem}" in
  auto|cmake|meson|autotools|configure|make|perl|python|pip) ;;
  *) die "Unknown build system: ${buildSystem} (try --help)" ;;
esac
[[ "${buildSystem}" == "configure" ]] && buildSystem="autotools"

[[ ${#positional[@]} -ge 1 ]] || { usage; exit 1; }
[[ ${#positional[@]} -le 3 ]] || die "Too many arguments (expected SOURCE [VERSION] [NAME])"

# Build system packages as an unprivileged user. fakeroot gives the build
# a fake root identity, so chown and makepkg record root:root ownership.
if [[ "${NO_FAKEROOT:-0}" != "1" && "${EUID}" -ne 0 && -z "${FAKEROOTKEY:-}" ]]; then
  if command -v fakeroot >/dev/null 2>&1; then
    echo -e "${BOLDCYAN}Re-executing under fakeroot...${COLOR_RESET}" >&2
    exec fakeroot -- bash "${ME}" "${ORIG_ARGS[@]}"
  else
    echo -e "${BOLDYELLOW}Warning:${COLOR_RESET} fakeroot not found; package ownership may not be root:root" >&2
  fi
elif [[ "${NO_FAKEROOT:-0}" == "1" && "${EUID}" -ne 0 && -z "${FAKEROOTKEY:-}" ]]; then
  echo -e "${BOLDYELLOW}Warning:${COLOR_RESET} NO_FAKEROOT=1; package ownership may not be root:root" >&2
fi

export SRCPKG="$(basename "${positional[0]}")"
[[ ${#positional[@]} -ge 2 && -z "${VERSION:-}" ]] && export VERSION="${positional[1]}"
[[ ${#positional[@]} -ge 3 && -z "${NAME:-}" ]] && export NAME="${positional[2]}"

# Strip a source extension, keeping version dots intact.
stripSourceExt() {
  local base="$1"
  if [[ -d "${CWD}/${base}" ]]; then
    printf '%s\n' "${base}"
    return 0
  fi
  case "${base}" in
    *.tar.gz)   base="${base%.tar.gz}" ;;
    *.tar.xz)   base="${base%.tar.xz}" ;;
    *.tar.bz2)  base="${base%.tar.bz2}" ;;
    *.tar.zst)  base="${base%.tar.zst}" ;;
    *.tar)      base="${base%.tar}" ;;
    *.tgz)      base="${base%.tgz}" ;;
    *.txz)      base="${base%.txz}" ;;
    *.tbz)      base="${base%.tbz}" ;;
    *.tlz)      base="${base%.tlz}" ;;
    *.zip)      base="${base%.zip}" ;;
    *.rpm)      base="${base%.rpm}" ;;
    *.deb)      base="${base%.deb}" ;;
    *.AppImage) base="${base%.AppImage}" ;;
    *.appimage) base="${base%.appimage}" ;;
    *.pip)      base="${base%.pip}" ;;
    *.url)      base="${base%.url}" ;;
    *.git)      base="${base%.git}" ;;
    *.pkg)      base="${base%.pkg}" ;;
    *)          base="${base%.*}" ;;
  esac
  printf '%s\n' "${base}"
}

# SOURCE can be a real file in CWD or a bare package name.
if [[ -z "${NAME:-}" ]]; then
  if [[ -e "${CWD}/${SRCPKG}" ]]; then
    base="$(stripSourceExt "${SRCPKG}")"
    if [[ "${SRCPKG}" == *.git && "${base}" =~ ^(.+)-(MASTER|LATEST)(-.*)?$ ]]; then
      NAME="${BASH_REMATCH[1]}"
      [[ -z "${VERSION:-}" ]] && VERSION="${BASH_REMATCH[2]}"
    elif [[ "${base}" =~ ^(.+)-([0-9][A-Za-z0-9._+~-]*)$ ]]; then
      NAME="${BASH_REMATCH[1]}"
      [[ -z "${VERSION:-}" ]] && VERSION="${BASH_REMATCH[2]}"
    else
      NAME="${base}"
    fi
  else
    export NAME="${SRCPKG}"
    for candidate in \
      "${NAME}"*.tar.gz "${NAME}"*.tar.xz "${NAME}"*.tar.bz2 \
      "${NAME}"*.tar.zst "${NAME}"*.tar "${NAME}"*.tgz "${NAME}"*.txz \
      "${NAME}"*.tbz "${NAME}"*.tlz "${NAME}"*.zip "${NAME}"*.rpm \
      "${NAME}"*.deb "${NAME}"*.AppImage "${NAME}"*.appimage "${NAME}"*.pip "${NAME}"*.url \
      "${NAME}"*.git "${NAME}"*.pkg; do
      if [[ -e "${CWD}/${candidate}" ]]; then
        SRCPKG="${candidate}"
        break
      fi
    done
    [[ -e "${CWD}/${SRCPKG}" ]] || die "No source archive or recipe found for ${NAME}"
  fi
fi

[[ "${NAME}" != *" "* && "${NAME}" != */* ]] || die "Invalid package name: ${NAME}"
export NAME

# BUILD defaults to today's date (YYMMDD) unless the caller exported one.
BUILD="${BUILD:-$(date '+%y%m%d')}"
BUILD="${BUILD//-/_}"
BUILD="${BUILD//\//_}"
export BUILD

# VERSION defaults to the version part of the source name. Git recipes also
# understand MASTER and LATEST (see the git extraction branch below).
if [[ -z "${VERSION:-}" ]]; then
  base="$(stripSourceExt "${SRCPKG}")"
  if [[ "${SRCPKG}" == *.git ]]; then
    if [[ "${base}" =~ ^(.+)-(MASTER|LATEST)(-.*)?$ ]]; then
      VERSION="${BASH_REMATCH[2]}"
    else
      VERSION="LATEST"
    fi
  elif [[ "${base}" =~ ^(.+)-([0-9][A-Za-z0-9._+~-]*)$ ]]; then
    VERSION="${BASH_REMATCH[2]}"
  else
    VERSION="${base##*-}"
  fi
fi
export VERSION

# Standard Slackware build environment. ARCH/LIBDIRSUFFIX are detected,
# while still allowing the caller to override them from the environment.
export ARCH="${ARCH:-$(uname -m)}"
case "${ARCH}" in
  x86_64|aarch64|ppc64le|s390x|riscv64) LIBDIRSUFFIX="${LIBDIRSUFFIX:-64}" ;;
  *) LIBDIRSUFFIX="${LIBDIRSUFFIX:-}" ;;
esac
export LIBDIRSUFFIX
export CFLAGS="${CFLAGS:--O2 -fPIC}"
export CXXFLAGS="${CXXFLAGS:--O2 -fPIC}"
export CMAKEFLAGS="${CMAKEFLAGS:-}"
export PREFIX="${PREFIX:-/usr}"
export LIBINSTALLDIR="${LIBINSTALLDIR:-${PREFIX}/lib${LIBDIRSUFFIX}}"
export ICEAUTH="${PREFIX}/bin/iceauth"
export STRIP="${STRIP:-ON}"
export EXTRACONFIG="${EXTRACONFIG:-}"
export TMP="${CWD}/tmp"
[[ "${TMP}" != "/" && "${TMP}" != "/tmp" ]] || die "Refusing to use ${TMP} as temporary directory"
export OUTPUT="${OUTPUT:-/tmp}"
mkdir -p "${OUTPUT}" || die "Cannot create output directory: ${OUTPUT}"

cd "${CWD}" || exit 1
rm -rf "${TMP}"
mkdir -p "${TMP}"
echo -e "${BOLDCYAN}Extracting source ${SRCPKG} ${COLOR_RESET}"

##############################################################
# Extract / fetch the source according to its type, and prepare
# a NAME-build.sh for the package types that need a custom recipe
##############################################################
cd "${TMP}" || exit 1

gitCheckoutTag() {
  local tag="$1"
  git checkout "tags/${tag}" 2>/dev/null || \
  git checkout "tags/v${tag}" 2>/dev/null || \
  git checkout "${tag}" 2>/dev/null || \
  git checkout "v${tag}" || exit 1
}

# Dispatch on the source package's extension. Plain archives (gz/xz/bz2/zip)
# are just extracted; binary package types are unpacked at build time.
SOURCE_TYPE="${SRCPKG##*.}"
case "${SOURCE_TYPE}" in
gz)
  tar zxvf "${CWD}/${SRCPKG}" || exit 1
  ;;
xz)
  tar Jxvf "${CWD}/${SRCPKG}" || exit 1
  ;;
bz2)
  tar jxvf "${CWD}/${SRCPKG}" || exit 1
  ;;
zip)
  unzip "${CWD}/${SRCPKG}" || exit 1
  ;;
url)
  # ${SRCPKG} is a text file whose first field is a download URL.
  URL="$(awk 'NF { print $1; exit }' "${CWD}/${SRCPKG}")"
  wget --no-check-certificate "$URL" || exit 1
  tar xf ./*.*z* 2>/dev/null || unzip -q ./*.zip || exit 1
  rm -f ./*.*z* ./*.zip
  ;;
git)
  # ${SRCPKG} is a text file whose first field is a git URL.
  # VERSION controls what gets checked out:
  #   MASTER -> master branch, package version GIT<BUILD-date>
  #   LATEST -> most recent tag, package version taken from that tag
  #   anything else -> that exact tag
  URL="$(awk 'NF { print $1; exit }' "${CWD}/${SRCPKG}")"
  TAG_FIELD="$(awk 'NF { print $2; exit }' "${CWD}/${SRCPKG}")"
  git clone "${URL}" || exit 1
  cd "$(find "${TMP}" -mindepth 1 -maxdepth 1 -type d -print -quit)" || exit 1
  git submodule update --init --recursive

  if [[ "${VERSION}" == "MASTER" ]]; then
    git checkout master 2>/dev/null || git checkout main || exit 1
    export VERSION="GIT${BUILD}"
  elif [[ "${VERSION}" == "LATEST" && -n "${TAG_FIELD}" ]]; then
    gitCheckoutTag "${TAG_FIELD}"
    export VERSION="$(printf '%s' "${TAG_FIELD}" | sed 's/^v//; s/[-_]/./g')"
  elif [[ "${VERSION}" == "LATEST" ]]; then
    TAG="$(git describe --tags --abbrev=0)" || exit 1
    gitCheckoutTag "${TAG}"
    export VERSION="$(printf '%s' "${TAG}" | sed 's/^v//; s/[-_]/./g')"
  else
    TAG="${TAG_FIELD:-${VERSION}}"
    gitCheckoutTag "${TAG}"
    export VERSION="$(printf '%s' "${TAG}" | sed 's/^v//; s/[-_]/./g')"
  fi
  ;;
rpm|deb|AppImage|appimage|skel|txz|pip|pkg)
  # Binary package/recipe types are unpacked by the build-stage case.
  mkdir -p "${TMP}/${NAME}-${SOURCE_TYPE}"
  [[ "${SOURCE_TYPE}" == "AppImage" || "${SOURCE_TYPE}" == "appimage" ]] && export STRIP="OFF"
  if [[ "${SOURCE_TYPE}" == "pip" ]]; then
    MODULE="${NAME}"
    export MODULE
  fi
  ;;
*)
  # Unknown extension: let tar auto-detect the compression.
  tar xf "${CWD}/${SRCPKG}" || exit 1
  ;;
esac

# ${PKG} is the staging root that will become the .txz package
# (everything "make install DESTDIR=${PKG}" writes ends up here).
# Slackware package filenames cannot contain hyphens in the version field.
PKG_VERSION="${VERSION//-/_}"
PKG_VERSION="${PKG_VERSION//\//_}"
PKG_VERSION="${PKG_VERSION//:/_}"
PKG_VERSION="${PKG_VERSION// /_}"
export PKG="${OUTPUT}/PKG_SKEL_${NAME}-${PKG_VERSION}-${ARCH}-${BUILD}"
rm -rf "${PKG}"
mkdir -p "${PKG}"

# ${SRC} is the top-level directory the archive extracted into.
SRC="$(find "${TMP}" -mindepth 1 -maxdepth 1 -type d -print -quit)"
[[ -n "${SRC}" ]] || SRC="${TMP}"
export SRC

##############################################################
cd "${SRC}" || die "Cannot enter source directory: ${SRC}"

# some custom pre build instructions
if [[ -e "${CWD}/${NAME}-prebuild.sh" ]]; then
  echo -e "${BOLDCYAN}Executing prebuild script${COLOR_RESET}"
  ( cd "${SRC}" && bash "${CWD}/${NAME}-prebuild.sh" )
elif [[ -e "${CWD}/prebuild.sh" ]]; then
  echo -e "${BOLDCYAN}Executing prebuild script${COLOR_RESET}"
  ( cd "${SRC}" && bash "${CWD}/prebuild.sh" )
fi

# unless you need to fix things..
# alias make="make -s"

# Shared build routine for the Makefile-based paths (classic configure and
# cmake): build, then install into ${PKG}.
makebuild() {
  local dir="${1:-${SRC}}"
  ( cd "${dir}" && make -j"${JOBS}" prefix="${PREFIX}" libdir="${LIBINSTALLDIR}" \
      mandir="${PREFIX}/man" PREFIX="${PREFIX}" LIBDIR="${LIBINSTALLDIR}" ) || exit 1
  ( cd "${dir}" && make install DESTDIR="${PKG}" prefix="${PREFIX}" \
      libdir="${LIBINSTALLDIR}" mandir="${PREFIX}/man" PREFIX="${PREFIX}" \
      LIBDIR="${LIBINSTALLDIR}" ) || exit 1
}

runConfigureHook() {
  if [[ -e "${CWD}/${NAME}-configure.sh" ]]; then
    source "${CWD}/${NAME}-configure.sh" || exit 1
  elif [[ -e "${CWD}/configure.sh" ]]; then
    source "${CWD}/configure.sh" || exit 1
  fi
}

buildAutotools() {
  echo -e "${BOLDCYAN}Building and installing source (AUTOTOOLS)${COLOR_RESET}"
  runConfigureHook
  echo -e "${BOLDCYAN}Configure options are : ${CONFIG} ${COLOR_RESET}"

  if [[ ! -e "${SRC}/configure" ]]; then
    if [[ -e "${SRC}/autogen.sh" ]]; then
      ( cd "${SRC}" && bash ./autogen.sh ) || exit 1
    else
      ( cd "${SRC}" && autoreconf -fiv ) || exit 1
    fi
  fi

  if [[ -x "${SRC}/configure" ]]; then
    ( cd "${SRC}" && ./configure ${CONFIG} ) || exit 1
  elif [[ -e "${SRC}/configure" ]]; then
    ( cd "${SRC}" && sh ./configure ${CONFIG} ) || exit 1
  fi
  makebuild
}

buildMeson() {
  echo -e "${BOLDCYAN}Building and installing source (MESON)${COLOR_RESET}"
  export CONFIG="\
--prefix=${PREFIX} \
--libdir=lib${LIBDIRSUFFIX} \
--mandir=man \
--infodir=info \
--localedir=share/locale \
--sysconfdir=/etc \
--localstatedir=/var \
--sharedstatedir=/var/lib \
--datadir=share \
--buildtype=release \
--optimization=2 \
--default-library=shared \
${EXTRACONFIG}"
  runConfigureHook
  echo -e "${BOLDCYAN}Configure options are : ${CONFIG} ${COLOR_RESET}"
  rm -rf "${SRC}/builddir"
  ( cd "${SRC}" && meson setup builddir ${CONFIG} ) || exit 1
  ( cd "${SRC}" && meson compile -C builddir -j "${JOBS}" ) || exit 1
  ( cd "${SRC}" && DESTDIR="${PKG}" meson install -C builddir ) || exit 1
}

buildPython() {
  echo -e "${BOLDCYAN}Building and installing source (PYTHON)${COLOR_RESET}"
  export CONFIG="--prefix=${PREFIX} --root=${PKG}"
  runConfigureHook
  echo -e "${BOLDCYAN}Configure options are : ${CONFIG} ${COLOR_RESET}"
  if [[ -e "${SRC}/setup.py" ]]; then
    ( cd "${SRC}" && python3 setup.py install ${CONFIG} ) || exit 1
  else
    ( cd "${SRC}" && python3 -m pip install --no-deps --root "${PKG}" --prefix "${PREFIX}" . ) || exit 1
  fi
}

buildPip() {
  echo -e "${BOLDCYAN}Building and installing source (PIP)${COLOR_RESET}"
  ( cd "${SRC}" && python3 -m pip install --no-deps --root "${PKG}" --prefix "${PREFIX}" . ) || exit 1
}

buildRpm() {
  echo -e "${BOLDCYAN}Unpacking RPM package${COLOR_RESET}"
  ( cd "${PKG}" && set -o pipefail && \
    rpm2cpio "${CWD}/${SRCPKG}" | cpio -i -m -d >/dev/null 2>&1 ) || exit 1
}

buildDeb() {
  echo -e "${BOLDCYAN}Unpacking DEB package${COLOR_RESET}"
  (
    cd "${PKG}" || exit 1
    ar x "${CWD}/${SRCPKG}" || exit 1
    for data in data.tar.*; do
      tar -xf "${data}" || exit 1
      break
    done
    rm -f data.tar.* control.tar.* debian-binary
  ) || exit 1
}

buildAppImage() {
  echo -e "${BOLDCYAN}Unpacking AppImage${COLOR_RESET}"
  chmod 755 "${CWD}/${SRCPKG}"
  ( cd "${SRC}" && "${CWD}/${SRCPKG}" --appimage-extract >/dev/null 2>&1 ) || exit 1

  mkdir -p "${PKG}/usr/share/applications"
  mkdir -p "${PKG}/usr/share/icons/hicolor/48x48/apps"
  mkdir -p "${PKG}/usr/bin"

  local desktop icon
  desktop="$(find "${SRC}" -name "*${NAME}*.desktop" -print -quit)"
  [[ -n "${desktop}" ]] && cp -f "${desktop}" "${PKG}/usr/share/applications/"

  icon="$(find "${SRC}" -name "*${NAME}*.png" -print -quit)"
  [[ -n "${icon}" ]] && cp -f "${icon}" "${PKG}/usr/share/icons/hicolor/48x48/apps/"

  for desktop in "${PKG}/usr/share/applications/"*.desktop; do
    [[ -e "${desktop}" ]] || continue
    sed -i "s/^Exec=.*$/Exec=${NAME}  %U/g" "${desktop}"
    sed -i "s/^TryExec=.*$/TryExec=${NAME}/g" "${desktop}"
    grep -q '^NoDisplay=true' "${desktop}" && rm -f "${desktop}"
  done

  cp "${CWD}/${SRCPKG}" "${PKG}/usr/bin/${NAME}"
  chmod 755 "${PKG}/usr/bin/${NAME}"
}

buildSkel() {
  echo -e "${BOLDCYAN}Copying skeleton tree${COLOR_RESET}"
  cp -rpf "${CWD}/${SRCPKG}/." "${PKG}/" || exit 1
}

buildTxz() {
  echo -e "${BOLDCYAN}Unpacking Slackware package${COLOR_RESET}"
  ( cd "${PKG}" && tar xf "${CWD}/${SRCPKG}" ) || exit 1
  if [[ -e "${PKG}/install/doinst.sh" ]]; then
    ( cd "${PKG}" && bash install/doinst.sh ) || exit 1
  fi
}

buildPipSource() {
  echo -e "${BOLDCYAN}Installing Python module${COLOR_RESET}"
  python3 -m pip install --no-deps --root "${PKG}" --prefix "${PREFIX}" "${MODULE}" || exit 1
}

buildPerl() {
  echo -e "${BOLDCYAN}Building and installing source (PERL)${COLOR_RESET}"
  export CONFIG="PREFIX=${PREFIX} INSTALLDIRS=vendor"
  runConfigureHook
  echo -e "${BOLDCYAN}Configure options are : ${CONFIG} ${COLOR_RESET}"
  ( cd "${SRC}" && perl Makefile.PL ${CONFIG} ) || exit 1
  ( cd "${SRC}" && make -j"${JOBS}" ) || exit 1
  ( cd "${SRC}" && make install DESTDIR="${PKG}" ) || exit 1
}

buildCmake() {
  echo -e "${BOLDCYAN}Building and installing source (CMAKE)${COLOR_RESET}"
  export CONFIG="\
-DCMAKE_POSITION_INDEPENDENT_CODE:BOOL=ON \
-DCMAKE_INSTALL_PREFIX:STRING=${PREFIX} \
-DCMAKE_INSTALL_LIBDIR:STRING=lib${LIBDIRSUFFIX} \
-DLIB_SUFFIX:STRING=${LIBDIRSUFFIX} \
-DLIB_INSTALL_DIR:STRING=${LIBINSTALLDIR} \
-DCMAKE_SKIP_RPATH:BOOL=ON \
-DWITH_DOCDIR:STRING=${PREFIX}/doc/${NAME}-${VERSION} \
-DMAN_INSTALL_DIR:STRING=${PREFIX}/man \
-DSYSCONF_INSTALL_DIR:STRING=/etc \
-DINCLUDE_INSTALL_DIR:STRING=${PREFIX}/include \
-DBUILD_SHARED_LIBS:BOOL=ON \
-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
-DCMAKE_BUILD_TYPE=Release \
${CMAKEFLAGS} ${EXTRACONFIG}"
  runConfigureHook
  echo -e "${BOLDCYAN}Configure options are : ${CONFIG} ${COLOR_RESET}"
  rm -rf "${SRC}/builddir"
  mkdir -p "${SRC}/builddir"
  ( cd "${SRC}/builddir" && cmake ${CONFIG} "${SRC}" ) || exit 1
  makebuild "${SRC}/builddir"
}

buildMake() {
  echo -e "${BOLDCYAN}Building and installing source (MAKE)${COLOR_RESET}"
  export CONFIG=""
  runConfigureHook
  makebuild
}

detectBuildSystem() {
  if [[ -e "${SRC}/meson.build" ]]; then
    echo "meson"
  elif [[ -e "${SRC}/CMakeLists.txt" || -e "${SRC}/cmakelists.txt" ]]; then
    echo "cmake"
  elif [[ -e "${SRC}/Makefile.PL" ]]; then
    echo "perl"
  elif [[ -e "${SRC}/setup.py" || -e "${SRC}/pyproject.toml" || -e "${SRC}/setup.cfg" ]]; then
    echo "python"
  elif [[ -e "${SRC}/configure" || -e "${SRC}/configure.ac" || -e "${SRC}/autogen.sh" ]]; then
    echo "autotools"
  elif [[ -e "${SRC}/Makefile" || -e "${SRC}/GNUmakefile" || -e "${SRC}/makefile" ]]; then
    echo "make"
  else
    echo "none"
  fi
}

runBuildHook() {
  echo -e "${BOLDCYAN}Executing $(basename "$1")${COLOR_RESET}"
  ( cd "${SRC}" && bash "$1" ) || exit 1
}

# Apply every NAME-*.patch found next to the script, in glob order.
echo -e "${BOLDCYAN}Applying patches${COLOR_RESET}"
for PATCH in "${CWD}/${NAME}"-*.patch; do
  [[ -e "${PATCH}" ]] || continue
  echo "From ${PATCH} >>>"
  ( cd "${SRC}" && patch -p1 < "${PATCH}" ) || exit 1
done

echo -e "${BOLDCYAN}About to build ${NAME} ${COLOR_RESET}"
echo -e "${BOLDCYAN}Using source ${SRCPKG} ${COLOR_RESET}"
echo -e "${BOLDCYAN}output package will be ${OUTPUT}/${NAME}-${PKG_VERSION}-${ARCH}-${BUILD}.txz ${COLOR_RESET}"

# Default Autotools options. Also visible to custom build hooks, which may
# override $CONFIG through NAME-configure.sh or directly.
export CONFIG="\
--prefix=${PREFIX} \
--libdir=${LIBINSTALLDIR} \
--sysconfdir=/etc \
--localstatedir=/var \
--mandir=${PREFIX}/man \
--infodir=${PREFIX}/info \
--localedir=${PREFIX}/share/locale \
--docdir=${PREFIX}/doc/${NAME}-${VERSION} \
--enable-shared \
--disable-static \
--disable-dependency-tracking \
--disable-debug \
--disable-rpath \
--build=${ARCH}-slackware-linux \
--host=${ARCH}-slackware-linux \
${EXTRACONFIG}"

# Build dispatcher. Binary package/recipe types are handled directly here;
# custom build hooks still take precedence. Source archives go through the
# normal custom-hook / auto-detection logic.
case "${SOURCE_TYPE}" in
  rpm|deb|AppImage|appimage|skel|txz|pip|pkg)
    if [[ -e "${CWD}/${NAME}-build.sh" ]]; then
      runBuildHook "${CWD}/${NAME}-build.sh"
    elif [[ -e "${CWD}/build.sh" ]]; then
      runBuildHook "${CWD}/build.sh"
    else
      case "${SOURCE_TYPE}" in
        rpm)               buildRpm ;;
        deb)               buildDeb ;;
        AppImage|appimage) buildAppImage ;;
        skel)              buildSkel ;;
        txz)               buildTxz ;;
        pip)               buildPipSource ;;
        pkg)               die "A .pkg source needs a custom ${NAME}-build.sh" ;;
      esac
    fi
    ;;
  *)
    if [[ "${buildSystem}" != "auto" ]]; then
      case "${buildSystem}" in
        autotools) buildAutotools ;;
        cmake)     buildCmake ;;
        meson)     buildMeson ;;
        make)      buildMake ;;
        perl)      buildPerl ;;
        python)    buildPython ;;
        pip)       buildPip ;;
        *)         die "Unsupported build system: ${buildSystem}" ;;
      esac
    elif [[ -e "${CWD}/${NAME}-build.sh" ]]; then
      runBuildHook "${CWD}/${NAME}-build.sh"
    elif [[ -e "${CWD}/build.sh" ]]; then
      runBuildHook "${CWD}/build.sh"
    else
      DETECTED="$(detectBuildSystem)"
      echo -e "${BOLDCYAN}Detected build system: ${DETECTED}${COLOR_RESET}"
      case "${DETECTED}" in
        autotools) buildAutotools ;;
        cmake)     buildCmake ;;
        meson)     buildMeson ;;
        make)      buildMake ;;
        perl)      buildPerl ;;
        python)    buildPython ;;
        none)      die "No build system detected in ${SRC}; use --build-system or a custom ${NAME}-build.sh" ;;
        *)         die "Unsupported build system: ${DETECTED}" ;;
      esac
    fi
    ;;
esac

if [[ -z "$(find "${PKG}" -mindepth 1 -print -quit 2>/dev/null)" ]]; then
  die "Build produced no files in ${PKG}"
fi

# Some build systems install under /usr/local instead of /usr — flatten
# that back into the normal ${PREFIX} layout so the package is consistent.
# In case local is used
if [[ -d "${PKG}${PREFIX}/local/bin" ]]; then
  mkdir -p "${PKG}${PREFIX}/bin"
  mv "${PKG}${PREFIX}/local/bin/"* "${PKG}${PREFIX}/bin/"
fi
if [[ -d "${PKG}${PREFIX}/local/sbin" ]]; then
  mkdir -p "${PKG}${PREFIX}/sbin"
  mv "${PKG}${PREFIX}/local/sbin/"* "${PKG}${PREFIX}/sbin/"
fi
if [[ -d "${PKG}${PREFIX}/local/include" ]]; then
  mkdir -p "${PKG}${PREFIX}/include"
  mv "${PKG}${PREFIX}/local/include/"* "${PKG}${PREFIX}/include/"
fi
if [[ -d "${PKG}${PREFIX}/local/lib64" ]]; then
  mkdir -p "${PKG}${LIBINSTALLDIR}"
  mv "${PKG}${PREFIX}/local/lib64/"* "${PKG}${LIBINSTALLDIR}/"
fi
if [[ -d "${PKG}${PREFIX}/local/lib" ]]; then
  mkdir -p "${PKG}${LIBINSTALLDIR}"
  mv "${PKG}${PREFIX}/local/lib/"* "${PKG}${LIBINSTALLDIR}/"
fi
rm -rf "${PKG}/usr/local"

# Debian-style multiarch installs into /usr/lib64/x86_64-linux-gnu — move
# that content into ${LIBINSTALLDIR} (usr/lib64) instead, and fix up any
# symlinks or text files (pkg-config files, libtool wrappers, etc.) that
# still reference the old multiarch path.
if [[ -d "${PKG}/usr/lib64/x86_64-linux-gnu" ]]; then
  mkdir -p "${PKG}${LIBINSTALLDIR}"
  mv "${PKG}/usr/lib64/x86_64-linux-gnu/"* "${PKG}${LIBINSTALLDIR}/"
  rmdir "${PKG}/usr/lib64/x86_64-linux-gnu"
  find "${PKG}" -type l -print0 | while IFS= read -r -d '' file; do
    linktarget="$(readlink "${file}")"
    if [[ "${linktarget}" == *"lib/x86_64-linux-gnu/"* ]]; then
      newlinktarget="$(printf '%s' "${linktarget}" | sed 's|lib/x86_64-linux-gnu/|lib64/|g')"
      rm -f "${file}"
      ln -s "${newlinktarget}" "${file}"
    fi
  done
  find "${PKG}" -type f -print0 | while IFS= read -r -d '' file; do
    if grep -Iq . "${file}" 2>/dev/null && grep -q "lib/x86_64-linux-gnu/" "${file}" 2>/dev/null; then
      sed -i 's|lib/x86_64-linux-gnu/|lib64/|g' "${file}"
    fi
  done
fi

# Some upstream installers drop everything under /opt — relocate that
# into ${LIBINSTALLDIR} too, again fixing up symlinks and text references.
# In case /opt is used
if [[ -d "${PKG}/opt" ]]; then
  mkdir -p "${PKG}${LIBINSTALLDIR}"
  mv "${PKG}/opt/"* "${PKG}${LIBINSTALLDIR}/"
  rmdir "${PKG}/opt"
  find "${PKG}" -type l -print0 | while IFS= read -r -d '' file; do
    linktarget="$(readlink "${file}")"
    if [[ "${linktarget}" == *"opt/"* ]]; then
      newlinktarget="$(printf '%s' "${linktarget}" | sed 's|opt/|usr/lib64/|g')"
      rm -f "${file}"
      ln -s "${newlinktarget}" "${file}"
    fi
  done
  find "${PKG}" -type f -print0 | while IFS= read -r -d '' file; do
    if grep -Iq . "${file}" 2>/dev/null && grep -q "opt/" "${file}" 2>/dev/null; then
      sed -i 's|opt/|usr/lib64/|g' "${file}"
    fi
  done
fi

# Finally, catch-all: fold any remaining ${PREFIX}/lib into ${PREFIX}/lib64
# on 64-bit builds, and rewrite leftover /usr/lib/ references.
if [[ "${LIBDIRSUFFIX}" == "64" ]]; then
  mkdir -p "${PKG}${PREFIX}/lib64"
  mv "${PKG}${PREFIX}/lib/"* "${PKG}${PREFIX}/lib64/" 2>/dev/null
  rmdir "${PKG}${PREFIX}/lib" "${PKG}${PREFIX}/lib64" 2>/dev/null
  find "${PKG}${PREFIX}" -type l -print0 | while IFS= read -r -d '' file; do
    linktarget="$(readlink "${file}")"
    if [[ "${linktarget}" == *"/lib/"* ]]; then
      newlinktarget="$(printf '%s' "${linktarget}" | sed 's|/lib/|/lib64/|g')"
      rm -f "${file}"
      ln -s "${newlinktarget}" "${file}"
    fi
  done
  find "${PKG}${PREFIX}" -type f -print0 | while IFS= read -r -d '' file; do
    if grep -Iq . "${file}" 2>/dev/null && grep -q "/usr/lib/" "${file}" 2>/dev/null; then
      sed -i 's|/usr/lib/|/usr/lib64/|g' "${file}"
    fi
  done
fi

# Copy standard doc files from the source tree, plus a copy of this
# SlackBuild script itself and the pre/build/post-build scripts used,
# so the package carries its own build recipe for reference.
DOCDIR="${PKG}${PREFIX}/doc/${NAME}-${VERSION}"
echo -e "${BOLDCYAN}Installing docs in ${DOCDIR} ${COLOR_RESET}"
mkdir -p "${DOCDIR}"
(
  cd "${SRC}" || exit 1
  cp -f AUTHORS* LICENCE* COPYING* INSTALL README* TODO NEWS ChangeLog NOTICE Copyright Changelog documentation/* "${DOCDIR}" 2>/dev/null
  cat "${ME}" > "${DOCDIR}/${NAME}.SlackBuild"
  [[ -n "${EXTRACONFIG}" ]] && echo "${EXTRACONFIG}" > "${DOCDIR}/extraconfig"
)
[[ -e "${CWD}/${NAME}-prebuild.sh" ]] && cp -f "${CWD}/${NAME}-prebuild.sh" "${DOCDIR}/"
[[ -e "${CWD}/${NAME}-build.sh" ]] && cp -f "${CWD}/${NAME}-build.sh" "${DOCDIR}/"
[[ -e "${CWD}/${NAME}-postbuild.sh" ]] && cp -f "${CWD}/${NAME}-postbuild.sh" "${DOCDIR}/"

# some custom post build instructions
if [[ -e "${CWD}/${NAME}-postbuild.sh" ]]; then
  echo -e "${BOLDCYAN}Executing postbuild script${COLOR_RESET}"
  ( cd "${SRC}" && bash "${CWD}/${NAME}-postbuild.sh" )
elif [[ -e "${CWD}/postbuild.sh" ]]; then
  echo -e "${BOLDCYAN}Executing postbuild script${COLOR_RESET}"
  ( cd "${SRC}" && bash "${CWD}/postbuild.sh" )
fi

# Striptease #########################################################
# Strip debug symbols from ELF binaries/shared objects and kernel modules,
# drop leftover .la libtool files, and relocate man pages from
# share/man to the plain ${PREFIX}/man layout, gzipping them.
# Skipped entirely when STRIP=OFF (set above for AppImage packages).
if [[ "${STRIP}" != "OFF" ]]; then
  (
    cd "${PKG}" || exit 1
    echo -e "${BOLDCYAN}Stripping binaries${COLOR_RESET}"
    find . -type f -perm -u+x -print0 | while IFS= read -r -d '' file; do
      if file -b "${file}" 2>/dev/null | grep -q 'ELF.*executable'; then
        strip --strip-unneeded "${file}" 2>/dev/null
      fi
    done
    find . -type f \( -name '*.so' -o -name '*.so.*' \) -print0 | while IFS= read -r -d '' file; do
      if file -b "${file}" 2>/dev/null | grep -q 'ELF.*shared object'; then
        strip --strip-unneeded "${file}" 2>/dev/null
      fi
    done
    find . -type f -name '*.ko' -print0 | while IFS= read -r -d '' file; do
      strip --strip-debug "${file}" 2>/dev/null
    done

    echo -e "${BOLDCYAN}Removing .la files${COLOR_RESET}"
    find . -type f -name '*.la' -delete

    echo -e "${BOLDCYAN}Installing man pages if any${COLOR_RESET}"
    if [[ -d ".${PREFIX}/share/man" ]]; then
      mkdir -p ".${PREFIX}/man"
      cp -a ".${PREFIX}/share/man/." ".${PREFIX}/man/"
      rm -rf ".${PREFIX}/share/man"
    fi
    if [[ -d ".${PREFIX}/man" ]]; then
      find ".${PREFIX}/man" -type f \
        \( -name '*.[0-9]' -o -name '*.[0-9][a-z]*' \) ! -name '*.gz' \
        -exec gzip -9 -n {} + 2>/dev/null
    fi
  )
fi

# Redundant docs, if any (docs were already collected above into ${PREFIX}/doc).
rm -rf "${PKG}${PREFIX}/share/doc" "${PKG}${PREFIX}/share/gtk-doc"

# Absolute symlinks (pointing at /usr/... on the build machine) would break
# once the package is installed elsewhere, so rewrite them as relative.
find "${PKG}" -type l -print0 | while IFS= read -r -d '' symlink; do
  target="$(readlink "${symlink}")"
  if [[ "${target}" == /* ]]; then
    symlink_dir="$(dirname "${symlink}")"
    rel_target="$(realpath -m --relative-to="${symlink_dir}" "${target}")"
    echo "Converting: ${symlink} From: ${target} To: ${rel_target}"
    rm -f "${symlink}"
    ln -s "${rel_target}" "${symlink}"
  fi
done

##############################################################
cd ${CWD}

# slack-desc, doinst.sh
mkdir -p "${PKG}/install"

cat > "${PKG}/install/slack-desc" << END
${NAME}: ${NAME} ${VERSION}
${NAME}:
${NAME}: ${NAME} package for Slackware Linux.
${NAME}:
${NAME}: Built with SlackBuild from ${SRCPKG}.
${NAME}:
${NAME}:
${NAME}:
${NAME}:
${NAME}:
${NAME}:
END

# A NAME-slack-desc or slack-desc file next to the script always wins.
# Failing that, try to fetch an existing slack-desc from the network.
if [[ -e "${CWD}/${NAME}-slack-desc" ]]; then
  echo -e "${BOLDCYAN}Installing slack-desc${COLOR_RESET}"
  cat "${CWD}/${NAME}-slack-desc" > "${PKG}/install/slack-desc"
elif [[ -e "${CWD}/slack-desc" ]]; then
  echo -e "${BOLDCYAN}Installing slack-desc${COLOR_RESET}"
  cat "${CWD}/slack-desc" > "${PKG}/install/slack-desc"
else
  echo -e "${BOLDCYAN}looking up for existing slack-desc on Internet.....${COLOR_RESET}"
  for i in a ap d l n x xap xfce kde; do
    wget -q --spider --no-check-certificate --timeout=20 \
      "http://mirrors.slackware.com/slackware/slackware64-current/source/${i}/${NAME}/slack-desc" && break
  done
  if [[ "$?" = "0" ]]; then
    wget --no-check-certificate --timeout=20 -O "${PKG}/install/slack-desc" \
      "http://mirrors.slackware.com/slackware/slackware64-current/source/${i}/${NAME}/slack-desc"
    cat "${PKG}/install/slack-desc" > "${CWD}/${NAME}-slack-desc"
  else
    for i in academic accessibility audio business desktop development games gis graphics libraries misc multimedia network office perl python ruby system; do
      wget -q --spider --no-check-certificate --timeout=20 \
        "https://slackbuilds.org/slackbuilds/15.0/${i}/${NAME}/slack-desc" && break
    done
    if [[ "$?" = "0" ]]; then
      wget --no-check-certificate --timeout=20 -O "${PKG}/install/slack-desc" \
        "https://slackbuilds.org/slackbuilds/15.0/${i}/${NAME}/slack-desc"
      cat "${PKG}/install/slack-desc" > "${CWD}/${NAME}-slack-desc"
    fi
  fi
fi

# Build install/doinst.sh, the script Slackware's pkgtools runs right
# after installing the package.
echo -e "${BOLDCYAN}Installing post-install script doinst.sh${COLOR_RESET}"

echo "" > "${PKG}/install/doinst.sh"

# Refresh the desktop-file database, if this package ships any.
if [[ -e "${PKG}${PREFIX}/share/applications" ]]; then
  cat >> "${PKG}/install/doinst.sh" << END
if [[ -x ${PREFIX}/bin/update-desktop-database ]]; then
  ${PREFIX}/bin/update-desktop-database -q ${PREFIX}/share/applications >/dev/null 2>&1
fi
END
fi

# Refresh the GTK icon theme cache, if this package ships an icon theme.
if [[ -e "${PKG}${PREFIX}/share/icons/hicolor" ]]; then
  cat >> "${PKG}/install/doinst.sh" << END
if [[ -x ${PREFIX}/bin/gtk-update-icon-cache ]]; then
  ${PREFIX}/bin/gtk-update-icon-cache -q -t -f ${PREFIX}/share/icons/hicolor >/dev/null 2>&1
fi
END
fi

# Recompile GLib schemas / GIO modules, if this package ships any.
if [[ -e "${PKG}${PREFIX}/share/glib-2.0/schemas" ]]; then
  cat >> "${PKG}/install/doinst.sh" << END
if [[ -x ${PREFIX}/bin/glib-compile-schemas ]]; then
  ${PREFIX}/bin/glib-compile-schemas ${PREFIX}/share/glib-2.0/schemas >/dev/null 2>&1
fi
if [[ -x ${PREFIX}/bin/gio-querymodules ]]; then
  ${PREFIX}/bin/gio-querymodules ${LIBINSTALLDIR}/gio/modules >/dev/null 2>&1
fi
END
fi

# Rename every file under etc/ to *.new, so pkgtools never silently
# overwrites an admin's existing config file on install. A file can opt
# out by being named *.notnew (the suffix is stripped instead of .new).
if [[ -d "${PKG}/etc" ]]; then
  mapfile -d '' etcfiles < <(find "${PKG}/etc" -type f -print0)
  for f in "${etcfiles[@]}"; do
    if [[ "${f}" == *.notnew ]]; then
      mv "${f}" "${f%.notnew}"
    elif [[ "${f}" != *.new ]]; then
      mv "${f}" "${f}.new"
    fi
  done
fi

# Append the classic Slackware config() helper.
cat << "END" >> "${PKG}/install/doinst.sh"
config() {
  NEW="$1"
  OLD="$(dirname "$NEW")/$(basename "$NEW" .new)"
  if [ ! -r "$OLD" ]; then
    mv "$NEW" "$OLD"
  elif cmp -s "$OLD" "$NEW"; then
    rm -f "$NEW"
  fi
}
END

# Call config() for every *.new file the package actually ships.
if [[ -d "${PKG}/etc" ]]; then
  find "${PKG}/etc" -type f -name '*.new' -print0 | while IFS= read -r -d '' dotnew; do
    echo "config \"${dotnew#"${PKG}"/}\"" >> "${PKG}/install/doinst.sh"
  done
fi

# Append any fully custom doinst.sh content on top of everything generated above.
if [[ -e "${CWD}/${NAME}-doinst.sh" ]]; then
  cat "${CWD}/${NAME}-doinst.sh" >> "${PKG}/install/doinst.sh"
elif [[ -e "${CWD}/doinst.sh" ]]; then
  cat "${CWD}/doinst.sh" >> "${PKG}/install/doinst.sh"
fi

# Normalize ownership/permissions before packaging.
echo -e "${BOLDCYAN}Creating package...${COLOR_RESET}"
cd "${PKG}" || exit 1
chown -R root.root . 2>/dev/null
find . -type d -perm 0777 -exec chmod 755 {} +
find . -type f -perm 0777 -exec chmod 755 {} +
find . -type f -perm 0775 -exec chmod 755 {} +
find . -type f -perm 0666 -exec chmod 644 {} +
find . -type f -perm 0664 -exec chmod 644 {} +
find . -type f -perm 4777 -exec chmod 4755 {} +
find . -type f -perm 4775 -exec chmod 4755 {} +
chmod 644 install/slack-desc 2>/dev/null
chmod 755 install/doinst.sh 2>/dev/null

PKGFILE="${OUTPUT}/${NAME}-${PKG_VERSION}-${ARCH}-${BUILD}.txz"
[[ "${PKGFILE}" != "${CWD}/${SRCPKG}" ]] || die "Refusing to overwrite the source package"
command -v makepkg >/dev/null 2>&1 \
  || die "makepkg not found; ensure /sbin and /usr/sbin are in PATH"
rm -f "${PKGFILE}"
makepkg -l y -c n "${PKGFILE}" || exit 1

cat "${PKG}/install/slack-desc"

# Optionally generate a .dep file listing runtime dependencies.
if [[ -x /usr/bin/requiredbuilder ]]; then
  echo -e "${BOLDCYAN}Generating dependency file ${PKGFILE%.txz}.dep ${COLOR_RESET}"
  /usr/bin/requiredbuilder -z "${PKGFILE}" > "${PKGFILE%.txz}.dep"
fi

# Cleanup: remove the staging root now that the .txz is built.
# ${TMP} (the extracted source) is left behind for inspection/debugging.
cd "${CWD}"
rm -rf "${PKG}"
# rm -rf "${TMP}"
